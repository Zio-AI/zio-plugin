{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/zio-plugin-bridge.exe\" alert-hook --host codex",
            "timeout": 5,
            "commandWindows": "& \"${PLUGIN_ROOT}/bin/zio-plugin-bridge.exe\" alert-hook --host codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/zio-plugin-bridge.exe\" alert-hook --host codex",
            "timeout": 3,
            "commandWindows": "& \"${PLUGIN_ROOT}/bin/zio-plugin-bridge.exe\" alert-hook --host codex"
          }
        ]
      }
    ]
  }
}
